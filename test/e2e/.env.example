# Copy to `.env` and fill in. `.env` is git-ignored.
#
# Needed only by the vector-store tests. Without it the suite still runs and
# skips those tests with a loud warning.
OPENAI_API_KEY=

# Optional overrides
# E2E_EMBEDDING_MODEL=text-embedding-3-small
# E2E_OPENAI_BASE_URL=https://api.openai.com/v1
# COUCHBASE_IMAGE=couchbase:enterprise-8.0.1
# N8N_IMAGE_TAG=latest
# N8N_PORT=5678
# VERDACCIO_PORT=4873
